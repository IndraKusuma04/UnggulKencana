	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDatabase"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
p.id,
p.kodeproduk,
p.nama,
p.harga_jual,
p.harga_beli,
p.berat,
p.karat,
p.lingkar,
p.panjang,
p.keterangan,
p.image_produk, 
jp.jenis_produk AS jenisproduk, 
k.kondisi FROM `dbunggulkencana`.produk p 
JOIN `dbunggulkencana`.jenis_produk jp on p.jenisproduk_id = jp.id
JOIN `dbunggulkencana`.kondisi k on p.kondisi_id = k.id
WHERE p.status = 1]]>
	</queryString>
