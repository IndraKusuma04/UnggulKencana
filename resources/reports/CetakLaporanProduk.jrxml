	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDatabase"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
            p.kodeproduk, 
            jp.jenis_produk, 
            p.nama, 
            p.harga_jual, 
            p.harga_beli, 
            p.berat, 
            p.karat, 
            p.lingkar, 
            p.panjang, 
            k.kondisi, 
            p.image_produk
        FROM produk p
        JOIN jenis_produk jp ON p.jenisproduk_id = jp.id
        JOIN kondisi k ON p.kondisi_id = k.id]]>
	</queryString>
