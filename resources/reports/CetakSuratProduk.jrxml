	<parameter name="kodetransaksi" class="java.lang.String"/>
	<parameter name="kodeproduk" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT tr.kodetransaksi, pl.nama AS namapelanggan, pl.alamat, pl.kontak, pg.nama AS namauser, pr.kodeproduk, pr.nama AS namaproduk, pr.berat, pr.karat, pr.harga_jual, pr.image_produk,tr.total, pg.nama as namapegawai FROM `dbunggulkencana`.produk pr
JOIN keranjang kr ON pr.id = kr.produk_id
JOIN transaksi tr ON kr.kodekeranjang = tr.kodekeranjang_id
JOIN pelanggan pl ON tr.pelanggan_id = pl.id
JOIN diskon ds ON tr.diskon_id = ds.id
JOIN users us ON tr.oleh = us.id
JOIN pegawai pg ON us.pegawai_id = pg.id
WHERE tr.kodetransaksi =  $P{kodetransaksi}    AND pr.kodeproduk =  $P{kodeproduk}  ]]>
	</queryString>
