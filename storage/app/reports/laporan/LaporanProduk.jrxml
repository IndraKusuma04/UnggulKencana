	<queryString language="SQL">
		<![CDATA[SELECT pr.kodeproduk, jp.jenis_produk, pr.nama, pr.berat, pr.karat, pr.lingkar, pr.panjang, k.kondisi, pr.harga_jual, pr.harga_beli
FROM `dbunggulkencana`.produk pr
JOIN `dbunggulkencana`.jenis_produk jp ON pr.jenisproduk_id = jp.id
JOIN `dbunggulkencana`.kondisi k ON pr.kondisi_id = k.id]]>
	</queryString>
