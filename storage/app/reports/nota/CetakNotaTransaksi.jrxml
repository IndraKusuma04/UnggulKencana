<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CetakNotaTransaksi" pageWidth="595" pageHeight="420" orientation="Landscape" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="9d767c28-70ab-4bb2-b67f-2642cae0d668">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDatabase"/>
	<parameter name="Parameter1" class="java.lang.String"/>
	<parameter name="assetPath" class="java.lang.String"/>
	<parameter name="imagePath" class="java.lang.String"/>
	<parameter name="svgPath" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT tr.kodetransaksi,
	pl.nama AS namapelanggan,
	pl.alamat,
	pl.kontak,
	pg.nama AS namauser,
	pr.kodeproduk,
	pr.nama AS namaproduk,
	pr.berat,
	pr.karat,
	pr.harga_jual,
	pr.image_produk,
	kr.total AS totalkeranjang,
	(SELECT SUM( k2.total)
FROM dbunggulkencana.keranjang k2
WHERE 
	 k2.kodekeranjang = kr.kodekeranjang ) AS subtotal,
	tr.total AS grandtotal,
	tr.terbilang,
	ds.nilai AS nilaidiskon
FROM dbunggulkencana.produk pr
	JOIN dbunggulkencana.keranjang kr ON 
	 pr.id = kr.produk_id 
	JOIN dbunggulkencana.transaksi tr ON 
	 kr.kodekeranjang = tr.kodekeranjang_id 
	JOIN dbunggulkencana.pelanggan pl ON 
	 tr.pelanggan_id = pl.id 
	JOIN dbunggulkencana.diskon ds ON 
	 tr.diskon_id = ds.id 
	JOIN dbunggulkencana.users us ON 
	 tr.oleh = us.id 
	JOIN dbunggulkencana.pegawai pg ON 
	 us.pegawai_id = pg.id 
WHERE 
	 tr.kodetransaksi = $P{Parameter1}]]>
	</queryString>
