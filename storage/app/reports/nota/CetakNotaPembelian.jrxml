<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CetakNotaTransaksi" pageWidth="595" pageHeight="420" orientation="Landscape" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="9d767c28-70ab-4bb2-b67f-2642cae0d668">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="LocalDatabase"/>
	<parameter name="kodepembelian" class="java.lang.String"/>
	<parameter name="assetPath" class="java.lang.String"/>
	<parameter name="svgPath" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    pm.id,
    pm.kodepembelian,
    pm.kodepembelianproduk,
    pm.suplier_id,
    pm.pelanggan_id,
    pm.nonsuplierdanpembeli,
    pm.tanggal,
    pm.total_harga AS grandtotal,
    pm.oleh,
    pm.terbilang,

    COALESCE(pl.nama, sp.nama, pm.nonsuplierdanpembeli) AS nama_pihak,
    COALESCE(pl.alamat, sp.alamat, '-') AS alamat_pihak,
    COALESCE(pl.kontak, sp.kontak, '-') AS kontak_pihak,

    pg.nama AS pegawai_nama,

    pmr.id AS pembelianproduk_id,
    pmr.kodeproduk,
    pmr.nama AS nama_produk,
    pmr.harga_beli,
    pmr.harga_jual,
    pmr.berat,
    pmr.karat,
    pmr.lingkar,
    pmr.panjang,
    pmr.keterangan,
    pmr.kondisi_id,
    k.kondisi,
    pmr.subtotalharga,

    (SELECT SUM(subt.subtotalharga)
     FROM pembelian_produk subt
     WHERE subt.kodepembelianproduk = pmr.kodepembelianproduk
    ) AS total_keranjang

FROM pembelian pm
JOIN pembelian_produk pmr ON pm.kodepembelianproduk = pmr.kodepembelianproduk

LEFT JOIN pelanggan pl ON pm.pelanggan_id = pl.id
LEFT JOIN suplier sp ON pm.suplier_id = sp.id

LEFT JOIN users us ON pm.oleh = us.id
LEFT JOIN pegawai pg ON us.pegawai_id = pg.id

LEFT JOIN kondisi k ON pmr.kondisi_id = k.id

WHERE pm.kodepembelian = $P{kodepembelian}]]>
	</queryString>
